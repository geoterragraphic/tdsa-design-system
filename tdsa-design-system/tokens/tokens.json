{
  "name": "Terra Drone Arabia",
  "version": 1,
  "color": {
    "themes": [
      {
        "id": "light",
        "name": "Light (top of page)"
      },
      {
        "id": "dark",
        "name": "Dark (closing band, footer)"
      }
    ],
    "tokens": [
      {
        "name": "night",
        "value": "#0f0f56",
        "usage": "Night — primary dark. Headings and body text on white, daytime or sunset; dark sections (footer, closing CTA band). White text on it."
      },
      {
        "name": "dusk",
        "value": "#143893",
        "usage": "Dusk — primary brand blue. Titles, key shapes, primary buttons (white label). Body text on white/daytime/sunset passes (10.4:1 on white)."
      },
      {
        "name": "fineday",
        "value": "#25a1f4",
        "usage": "FineDay — accent. Highlights, hover states, chart series 1, links ON DARK (6.1:1 on night). Too light for small text on white (2.8:1): shapes, icons, 24px+ display text only — and even 24px+ on white is below 3:1, flagged."
      },
      {
        "name": "twilight",
        "value": "#09aeba",
        "usage": "Twilight — secondary accent (teal). Icons, chart series 3. Same limits as fineday: not for small text on light grounds (2.7:1 on white)."
      },
      {
        "name": "dawn",
        "value": "#094e59",
        "usage": "Dawn — deep teal. Secondary dark surfaces, chart series 4; muted text on light grounds (9.4:1 on white). White text on it."
      },
      {
        "name": "daytime",
        "value": "#cce6ff",
        "usage": "Daytime — light blue tint. Alternating section backgrounds, cards, table stripes. Night or dusk text on it."
      },
      {
        "name": "sunset",
        "value": "#dfd1d1",
        "usage": "Sunset — warm neutral. Dividers, chart gridlines, subtle backgrounds."
      },
      {
        "name": "white",
        "value": "#ffffff",
        "usage": "White — default page ground; text on night, dusk and dawn."
      },
      {
        "name": "surface",
        "value": {
          "light": "{white}",
          "dark": "{night}"
        },
        "usage": "Page ground. Light theme = the top of a page (header, hero, content); dark theme = the closing sections (footer, CTA band)."
      },
      {
        "name": "surface-alt",
        "value": {
          "light": "{daytime}",
          "dark": "{dawn}"
        },
        "usage": "Alternating section background, cards, table stripes."
      },
      {
        "name": "surface-warm",
        "value": {
          "light": "{sunset}",
          "dark": "{dawn}"
        },
        "usage": "Subtle warm background for quiet panels."
      },
      {
        "name": "surface-band",
        "value": {
          "light": "{night}",
          "dark": "{dawn}"
        },
        "usage": "The dark closing band (\"Data you can trust…\") and footer when seen from a light page."
      },
      {
        "name": "ink",
        "value": {
          "light": "{night}",
          "dark": "{white}"
        },
        "usage": "Headings and body text on surface, surface-alt, surface-warm."
      },
      {
        "name": "ink-brand",
        "value": {
          "light": "{dusk}",
          "dark": "{white}"
        },
        "usage": "Titles and emphasis in brand blue."
      },
      {
        "name": "ink-muted",
        "value": {
          "light": "{dawn}",
          "dark": "{daytime}"
        },
        "usage": "Captions, metadata, taglines."
      },
      {
        "name": "line",
        "value": {
          "light": "{sunset}",
          "dark": "{dawn}"
        },
        "usage": "Dividers and hairlines."
      },
      {
        "name": "action",
        "value": {
          "light": "{dusk}",
          "dark": "{fineday}"
        },
        "usage": "Primary button fill (Dusk). On dark grounds Dusk is only 1.65:1 against night, so dark sections use fineday — an assumption, not in the source; confirm."
      },
      {
        "name": "on-action",
        "value": {
          "light": "{white}",
          "dark": "{night}"
        },
        "usage": "Label on an action fill."
      },
      {
        "name": "link",
        "value": {
          "light": "{dusk}",
          "dark": "{fineday}"
        },
        "usage": "Text links (\"View All …\", \"Read More\"). The source names fineday for links, but it fails on white, so light grounds use dusk with fineday on hover."
      },
      {
        "name": "link-hover",
        "value": "{fineday}",
        "usage": "Link hover underline and hover states."
      },
      {
        "name": "chart-1",
        "value": "{fineday}",
        "usage": "Chart series 1."
      },
      {
        "name": "chart-2",
        "value": "{dusk}",
        "usage": "Chart series 2."
      },
      {
        "name": "chart-3",
        "value": "{twilight}",
        "usage": "Chart series 3. Close in lightness to chart-1 (1.04:1): label series directly, never by colour alone."
      },
      {
        "name": "chart-4",
        "value": "{dawn}",
        "usage": "Chart series 4."
      },
      {
        "name": "chart-5",
        "value": "{night}",
        "usage": "Chart series 5."
      },
      {
        "name": "chart-grid",
        "value": "{sunset}",
        "usage": "Chart gridlines."
      },
      {
        "name": "chart-label",
        "value": "{night}",
        "usage": "Chart axis and data labels."
      }
    ]
  },
